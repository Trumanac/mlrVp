# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/

# PyInstaller
build/
dist/
*.manifest

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Eggs
*.egg-info/
*.egg

# Distribution
*.whl
*.tar.gz
release/
installer.iss

# Audio samples / slices (user data)
data/slices/*.wav
data/slices/*.json
data/slices/*/

# Runtime data written by the app when running from a source checkout
# (end users' data lives in the per-user folders — see mlrvp/config.py)
data/defaults/*
!data/defaults/.gitkeep
data/racks/
data/songs/
data/logs/
data/ui_scale.txt
data/.migrated_from_legacy

# User presets and setlists (ignored so clones start blank)
data/presets/*.json
data/setlists/*.json
data/setlists/*/

# Logs
*.log

# Dev/planning files not for end users
FX_RACK_PLAN.md
SLICER_UPGRADE_SPEC.md
generate_icon.py
stress_test.py
stress_test_ringbuf.py
stress_results.txt
stress_output.txt
stress_out.txt
build_local.log
_test_editor.py
_test_load.py
tmp_*.txt

# Diagnostic / hardware probe scripts
diagnose_com7.py
diagnose_loopback.py
probe_40h.py
probe_tilt.py

# One-off migration utilities (not for end users)
_migrate_ui_scale.py

# Local dev backups
_backup/

# Test / lint artifacts
.coverage
.coverage.*
coverage.xml
htmlcov/
.pytest_cache/
.ruff_cache/

# Generated by build.py
THIRD_PARTY_LICENSES.txt
